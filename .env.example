# Auth OIDC/Keycloak
OIDC_CONFIG_URL=https://keycloak.agnisolution.fr/realms/mcp/.well-known/openid-configuration
OIDC_CLIENT_ID=mcp-postgres
OIDC_CLIENT_SECRET=<secret par Christophe>

# MCP Base URL
MCP_BASE_URL=https://mcp-postgres.agnisolution.fr

# Redis (stockage sessions/tokens chiffrés)
REDIS_URL=<Redis URL interne, par Christophe>

# Encryption keys
JWT_SIGNING_KEY=<généré par Christophe>
FERNET_SECRET=<généré par Christophe>

# PostgreSQL - Accès lecture seule (rôle mcp_ro)
DB_HOST=<IP VPS Hostinger>
DB_PORT=5432
DB_USER=mcp_ro
DB_PASSWORD=<secret par Christophe>
DB_WHITELIST=opepartner,calocalc_inscription,db_agni,nocodb_db
DB_DEFAULT=db_agni

# Limites de sécurité
QUERY_MAX_ROWS_DEFAULT=100
QUERY_MAX_ROWS_HARD=1000
STATEMENT_TIMEOUT_MS=5000
