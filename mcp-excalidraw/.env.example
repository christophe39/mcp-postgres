# ============================================
# MCP Excalidraw — Variables d'environnement
# Phase H.7 — MultiAuth OIDC + bearer fallback
# ============================================
# ⚠️ NE JAMAIS committer le fichier .env réel
# Ce fichier contient uniquement des placeholders

# --- PostgreSQL (user DÉDIÉ mcp_excalidraw, pas excalidraw_backend) ---
DATABASE_URL=postgresql://mcp_excalidraw:<PASSWORD>@10.0.1.23:5432/excalidraw_storage

# --- Excalidraw ---
EXCALIDRAW_BACKEND_URL=http://excalidraw-backend:8080   # interne Docker
EXCALIDRAW_FRONTEND_URL=https://excalidraw.agnisolution.fr

# --- NocoDB ---
NOCODB_URL=https://nocodb.agnisolution.fr
NOCODB_TOKEN=<TOKEN>
NOCODB_BASE_OPEPARTNER=boexlzlohgueed1

# --- AFFiNE ---
AFFINE_API_URL=https://affine.agnisolution.fr
AFFINE_WORKSPACE_OPEPARTNER=3869ae28-9638-4390-a28d-905ff5c563d6
AFFINE_TOKEN=<TOKEN>

# --- Auth du MCP (MultiAuth : OIDC + bearer fallback) ---
# OBLIGATOIRE en production (AUTH_ENABLED=true)
AUTH_ENABLED=true

# OIDC via Keycloak (realm "mcp", client "mcp-excalidraw")
OIDC_CONFIG_URL=https://keycloak.agnisolution.fr/realms/mcp/.well-known/openid-configuration
OIDC_CLIENT_ID=mcp-excalidraw
OIDC_CLIENT_SECRET=<gestionnaire Christophe : Keycloak / mcp-excalidraw / Credentials / client_secret>

# Base URL du MCP (pour redirect_uri et audience)
MCP_BASE_URL=https://mcp-excalidraw.agnisolution.fr

# Redis pour stockage état OAuth (client_storage) — OBLIGATOIRE
# Même Redis Coolify que mcp-jouet, mais DB /1 pour isoler les clients DCR
# Hostname interne du container Redis Coolify (le réseau "coolify" résout ce hostname)
REDIS_URL=redis://default:<PASSWORD>@jsggw8sww8kgkgcks0w0o8sw:6379/1

# Secrets JWT et chiffrement (générer avec : openssl rand -base64 32)
JWT_SIGNING_KEY=<openssl rand -base64 32>

# Chiffrement Fernet du storage Redis (clients OAuth dynamiques DCR) — OBLIGATOIRE
FERNET_SECRET=<openssl rand -base64 32>

# Bearer statique (fallback pour scripts/agents legacy, OPTIONNEL)
AUTH_BEARER_TOKEN=<token actuel inchangé, pour scripts/agents legacy>

# --- Config ---
DEFAULT_USER_ID=1
LOG_LEVEL=INFO
LOG_FILE=/var/log/mcp-excalidraw/app.log
RATE_LIMIT_PER_MIN=30
