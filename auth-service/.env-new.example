# Service d'authentification Excalidraw v2.0
# ==========================================

# Port du service
PORT=3000

# URL de connexion PostgreSQL
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://excalidraw_backend:PASSWORD@10.0.1.23:5432/excalidraw_storage

# SSL PostgreSQL (false pour connexion interne Docker)
DATABASE_SSL=false

# Environnement (development, production)
NODE_ENV=production

# Token secret pour l'endpoint /admin/create-user
# Générer avec : openssl rand -base64 32
ADMIN_TOKEN=CHANGE_ME_GENERATE_RANDOM_TOKEN

# Secret pour signer les cookies de session (NOUVEAU)
# Générer avec : openssl rand -base64 32
SESSION_SECRET=CHANGE_ME_GENERATE_RANDOM_SESSION_SECRET
